# ─── ROOT ─────────────────────────────────────────────────────────────────────
# Sviluppo: copia questo file come app/backend/.env e app/frontend/.env e
# compila con i valori reali.
# Produzione (docker-compose.prod.yml): copia questo file come .env in root
# (accanto a docker-compose.prod.yml) — DATABASE_URL/REDIS_URL vengono
# ricalcolate automaticamente dal compose a partire da POSTGRES_*, i valori
# qui sotto sono usati solo in sviluppo/standalone.

# ─── BACKEND ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cms:cms@localhost:5432/cms_db
REDIS_URL=redis://localhost:6379
# Usate solo da docker-compose.prod.yml: bootstrap del container postgres +
# DATABASE_URL ricalcolata per puntare al servizio "postgres" della rete Docker.
POSTGRES_DB=cms_db
POSTGRES_USER=cms
POSTGRES_PASSWORD=change_me_in_production
SECURITY_KEY=change_me_in_production_very_long_secret_min_32_chars
# Segreto dedicato del JWT di anteprima di una bozza (ADR-25 § 1): volutamente
# distinto da SECURITY_KEY (access/refresh), limita il danno di una fuga a
# questo solo uso. Durata fissa a 15 minuti, non configurabile via env.
PAGE_PREVIEW_TOKEN_SECRET=change_me_in_production_different_from_security_key
COOKIE_SECRET=change_me_cookie_secret
COOKIE_DOMAIN=localhost
JWT_EXPIRATION=15m
RTK_EXPIRATION=604800
PORT=3000
NODE_ENV=development
# In produzione: URL pubblico del frontend (CORS, app.enableCors in main.ts) —
# non lasciare localhost.
FRONTEND_URL=http://localhost:5173
# URL pubblico del sito SSR (ADR-22, workspace app/public-site, non ancora
# presente in F03/T2): CORS lo ammette da subito insieme a FRONTEND_URL.
PUBLIC_SITE_URL=http://localhost:4000
# Origine dell'API backend letta da app/public-site/src/config.ts (non da
# AppConstants, che è solo per app/backend). Default per sviluppo standalone
# (`npm run dev`); in produzione sovrascritta dal compose col nome del
# servizio Docker (http://backend:3000).
PUBLIC_API_BASE_URL=http://localhost:3000
# Lingua di default per la risoluzione pubblica degli slug (ADR-24 § 5/§ 7):
# assunzione dichiarata in attesa di F05/app_settings, non una regola approvata.
DEFAULT_LOCALE=it-IT
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_PER_SEC=100
# Storage documenti (ADR-8): 'local' in sviluppo (STORAGE_LOCAL_PATH), 's3' in
# produzione (bucket S3-compatibile: AWS S3, MinIO self-hosted, o altro provider
# che parla l'API S3 — STORAGE_S3_ENDPOINT vuoto per AWS reale).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_MAX_FILE_SIZE_MB=20
# Job repeatable BullMQ (ADR-11) di pulizia fisica blob orfani (file
# soft-deleted da ADR-8, oltre il periodo di grazia). Disabilitato di default:
# azione distruttiva sul blob fisico, opt-in esplicito del progetto verticale.
FILES_CLEANUP_ENABLED=false
FILES_CLEANUP_GRACE_DAYS=30
FILES_CLEANUP_CRON_PATTERN=0 3 * * *
FILES_CLEANUP_BATCH_SIZE=500
# Osservabilità opzionale (ADR-15): entrambe disattivate di default (opt-in
# esplicito, "non appesantire progetti piccoli"). Sentry accetta anche il DSN
# di un'istanza GlitchTip self-hosted (stesso protocollo). METRICS_ENABLED
# espone GET /metrics (formato Prometheus) SENZA autenticazione applicativa
# (convenzione scraper): se esposto fuori da rete interna/allowlist IP, va
# protetto a livello di reverse proxy.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
METRICS_ENABLED=false

# ─── FRONTEND ─────────────────────────────────────────────────────────────────
# In produzione: URL pubblico dell'API. "Baked" nel bundle statico a
# build-time da docker-compose.prod.yml (build arg) — cambiarla richiede di
# ricostruire l'immagine frontend, non basta un restart del container.
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Base Socket.io (namespace /realtime, campanella notifiche — ADR-12). Montato di
# default in app.module.ts: lasciarla commentata disabilita solo il push realtime,
# la campanella resta funzionante via REST (GET /app/notifications*).
VITE_SOCKET_URL=http://localhost:3000
# Sentry frontend opzionale (ADR-15), stesso opt-in del backend — lasciare
# assente/false per non inviare mai nulla a Sentry dal browser.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
