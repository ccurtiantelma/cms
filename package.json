{
  "name": "cms",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "overrides": {
    "react": "^19",
    "react-dom": "^19",
    "esbuild": "^0.25.12",
    "js-yaml": "^4.3.0",
    "@mantine/core": "7.17.0",
    "@mantine/hooks": "7.17.0",
    "@mantine/dates": "7.17.0",
    "@mantine/form": "7.17.0",
    "@mantine/notifications": "7.17.0"
  },
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND,PUBLIC\" -c \"cyan,magenta,green\" \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:public-site\"",
    "dev:backend": "npm run start:dev --workspace=app/backend",
    "dev:frontend": "npm run dev --workspace=app/frontend",
    "dev:public-site": "npm run build --workspace=app/public-site && npm run start --workspace=app/public-site",
    "build:backend": "npm run build --workspace=app/backend",
    "build:frontend": "npm run build --workspace=app/frontend",
    "build:public-site": "npm run build --workspace=app/public-site",
    "build": "npm run build:backend && npm run build:frontend && npm run build:public-site",
    "db:generate": "npm run db:generate --workspace=app/backend",
    "db:migrate": "npm run db:migrate --workspace=app/backend",
    "seed": "npm run seed --workspace=app/backend",
    "openapi:export": "npm run openapi:export --workspace=app/backend",
    "openapi:types": "openapi-typescript docs/openapi.yaml -o app/frontend/src/types/api.types.ts",
    "blocks:export": "npm run blocks:export --workspace=app/backend",
    "blocks:types": "node generate-blocks-types.js",
    "test": "npm run test --workspace=app/backend && npm run test --workspace=app/frontend",
    "test:e2e": "npm run test:e2e --workspace=app/backend -- --runInBand --forceExit",
    "test:e2e:browser": "playwright test --config=e2e/playwright.config.ts",
    "clean": "npx rimraf app/backend/dist app/frontend/dist app/public-site/dist node_modules app/backend/node_modules app/frontend/node_modules app/public-site/node_modules",
    "lint:backend": "npm run lint --workspace=app/backend",
    "lint:frontend": "npm run lint --workspace=app/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "format:backend": "npm run format --workspace=app/backend",
    "format:frontend": "npm run format --workspace=app/frontend",
    "format": "npm run format --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "concurrently": "^8.2.2",
    "openapi-typescript": "^7.13.0",
    "otplib": "^12.0.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@mantine/charts": "^9.5.2",
    "recharts": "^3.10.1"
  }
}
