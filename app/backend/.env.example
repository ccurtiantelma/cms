# Copia questo file come app/backend/.env e compila con i valori reali.
DATABASE_URL=postgresql://cms:cms@localhost:55432/cms_db
REDIS_URL=redis://localhost:56380
SECURITY_KEY=change_me_in_production_very_long_secret_min_32_chars
ANALYTICS_INGEST_SECRET=change_me_analytics_ingest_secret
# Segreto HMAC-SHA256(formKey, FORM_ANTISPAM_SECRET) del Form Builder (ADR-46 § 3).
FORM_ANTISPAM_SECRET=change_me_form_antispam_secret_key
COOKIE_SECRET=change_me_cookie_secret
COOKIE_DOMAIN=localhost
JWT_EXPIRATION=15m
RTK_EXPIRATION=604800
PORT=53000
NODE_ENV=development
FRONTEND_URL=http://localhost:55173
# Base URL rivolta al browser della rotta pubblica dei media (ADR-27 § 6):
# distinta da PUBLIC_API_BASE_URL (rivolta al server, host interno in prod).
PUBLIC_MEDIA_BASE_URL=http://localhost:53000
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_PER_SEC=100
# Export statico SSG (ADR-45): directory di output e batch size del job di
# export full-site (throttling della coda BullMQ, non del render per pagina).
STATIC_EXPORT_PATH=./dist/static-export
STATIC_EXPORT_FULL_SITE_BATCH_SIZE=10
