VITE_API_BASE_URL=http://localhost:53000/api/v1
# Base Socket.io (namespace /realtime, campanella notifiche — ADR-12). Montato di
# default in app.module.ts: lasciarla commentata disabilita solo il push realtime,
# la campanella resta funzionante via REST (GET /app/notifications*).
VITE_SOCKET_URL=http://localhost:53000
# Origine del sito pubblico SSR (`app/public-site`, ADR-22), usata dal pulsante
# "Vedi pagina" del dettaglio Pagina. Deve combaciare con PUBLIC_SITE_URL del backend.
VITE_PUBLIC_SITE_URL=http://localhost:54000
# Base URL rivolta al browser della rotta pubblica dei media (ADR-27 § 6),
# stesso valore di PUBLIC_MEDIA_BASE_URL del backend.
VITE_PUBLIC_MEDIA_BASE_URL=http://localhost:53000
