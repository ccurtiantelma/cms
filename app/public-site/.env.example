# Variabili d'ambiente per app/public-site (consumer SSR)
# Porte non standard di proposito (5432/6379 → 55432/56379 ecc.): il progetto
# gira sempre in parallelo con altri stack sulla stessa macchina di sviluppo,
# vedi il commento di testa di docker-compose.yml.

# Porta del server HTTP di questo workspace. Combacia col default di
# AppConstants.publicSiteUrl nel backend e con VITE_PUBLIC_SITE_URL nel
# frontend admin.
PORT=55000

# Origine dell'API backend (api/v1/public/pages, api/v1/preview/pages). In
# sviluppo locale punta a localhost:53000 (backend su porta non standard);
# in produzione sovrascritta dal docker-compose.prod.yml col nome del
# servizio Docker (http://backend:3000, invariato: riferimento interno alla
# rete Docker, non alla porta host).
PUBLIC_API_BASE_URL=http://localhost:53000

# Segreto condiviso col worker di export del backend (ADR-67). Se valorizzato,
# le Pagine pubblicate si rendono solo a chi presenta X-Export-Render-Token e
# ogni altra richiesta riceve 404 (in produzione lo impone il compose). Vuoto
# in sviluppo, per navigare il sito in locale; stesso valore del backend.
EXPORT_RENDER_SECRET=
